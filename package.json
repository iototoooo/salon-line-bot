{
  "name": "salon-line-bot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:types": "node scripts/supabase/gen-types.mjs",
    "check:supabase": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/supabase/check-connection.mts",
    "check:webhook-events": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/supabase/check-webhook-events.mts",
    "test:live-webhook": "vitest run --config vitest.live.config.mts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
