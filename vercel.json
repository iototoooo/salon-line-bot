{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["hnd1"],
  "schedules": {
    "owner-notify": {
      "schedule": "*/15 * * * *",
      "path": "/api/cron/owner-notify",
      "requestMethod": "GET"
    },
    "retention": {
      "schedule": "17 18 * * *",
      "path": "/api/cron/retention",
      "requestMethod": "GET"
    }
  }
}
