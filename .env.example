# 値はすべて空のままコミットする。実際の値は .env.local（Git管理外）に設定すること。
# 詳細は docs/architecture.md「5.4 環境変数」を参照。

# LINE Messaging API（開発中はテスト用公式アカウントの値のみ使用）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# dry-run（既定）: LINEへ送信せずログのみ / live: 実際に返信（テスト用アカウントで明示的に有効化するときだけ）
LINE_REPLY_MODE=dry-run

# 返信内容: echo（既定・ローカル検証用。本番では使用不可）/ ai（FAQ・メニュー・店舗情報に基づく AI 応答）
# ai には 5 本目のマイグレーション（20261112000000_conversation_ai_sources.sql）が必要（本番は 2026-11-11 に適用済み）
# ai でも shop_settings.bot_enabled = false の間は AI を呼ばず、定型文だけを返す
LINE_RESPONDER=

# Claude API（サーバー専用。NEXT_PUBLIC_ を付けない）
# ANTHROPIC_API_KEY が空の場合、AI 応答は定型文＋要オーナー対応になる（AI は呼ばない）
ANTHROPIC_API_KEY=
# 空欄なら claude-haiku-5-5（2026-11-11 に公式ドキュメントで確認したモデル ID）
CLAUDE_MODEL=

# Supabase（本案件のプロジェクト Ref: dnortggovlwgcdeoadbf 以外の URL は起動時に拒否される）
# 管理画面のログイン（Supabase Auth）用。公開されても問題ない値のみ。空なら管理画面にはログインできない
# 管理画面のデータ操作は、この publishable key＋ログイン中のセッション（RLS 適用）で行う（secret key は使わない）
NEXT_PUBLIC_SUPABASE_URL=
# publishable key（sb_publishable_…）を入れる。secret key は絶対に入れない（起動時にエラーになる）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。https://dnortggovlwgcdeoadbf.supabase.co を入れる。空なら NEXT_PUBLIC_SUPABASE_URL を使う
SUPABASE_URL=
# サーバー専用（RLS をバイパスする）。絶対に NEXT_PUBLIC_ を付けない・ブラウザに渡さない
# 変数名は従来のままだが、値は新形式の secret key（sb_secret_…）を入れる
# publishable key・legacy anon キー・形式不明の値は起動時にエラー。legacy service_role キーは予備としてのみ可
# 設定後は npm run check:supabase（読み取り専用）で接続を確認する
SUPABASE_SERVICE_ROLE_KEY=

# Webhook の重複判定ストア: supabase / memory（開発専用・本番では使用不可）
# 空欄なら Supabase の接続情報があれば supabase、なければ memory
WEBHOOK_EVENT_STORE=

# 通知に載せる管理画面URL（オーナー通知の「未対応一覧」リンク。https のみ有効。ローカル確認用に http://localhost も可）
APP_BASE_URL=http://localhost:3000

# オーナー通知（WBS 2.5）
#   - 宛先は shop_settings.owner_line_user_id だけ（ここでは指定しない）。LINE_REPLY_MODE=live のときだけ push する
#   - 7 本目のマイグレーション（20261114000000_owner_notifications.sql）が必要
# 定期実行（/api/cron/owner-notify。Vercel Schedules が 15 分ごとに呼ぶ）の認証用。32 文字以上・英数字のみのランダムな値。
# 空なら定期実行は無効（503）。本番は Vercel の Production 環境にだけ Sensitive で設定する（ローカルでは通常不要）
CRON_SECRET=

# 管理画面の安全スイッチ（既定はすべて OFF。ローカル開発中の誤操作で本番 DB・LINE・課金に触れないため）
# enabled: FAQ・メニュー・店舗情報・自動応答 ON/OFF・通知先・対応済み・配信の下書きを保存できる。空なら閲覧のみ
ADMIN_WRITE_MODE=
# live: 一斉配信のテスト送信（オーナーへの push）と本配信を行う（送信数の無料枠を消費）。空なら送信しない
# LINE_REPLY_MODE（お客様への返信）とは別のスイッチ
LINE_BROADCAST_MODE=
# live: 回答テスト画面で Claude API を呼ぶ（課金が発生。ANTHROPIC_API_KEY も必要）。空なら AI を呼ばない
ADMIN_ANSWER_TEST_MODE=
